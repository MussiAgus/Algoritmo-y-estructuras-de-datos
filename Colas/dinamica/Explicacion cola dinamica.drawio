        <mxCell id="sU-Si7dAp3TsRV8evkNk-99" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="&lt;b&gt;void crearCola (t_cola *cola)&lt;/b&gt;" vertex="1">
          <mxGeometry height="170" width="340" x="2235" y="1580" as="geometry">
            <mxRectangle height="30" width="190" x="480" y="600" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sU-Si7dAp3TsRV8evkNk-100" parent="sU-Si7dAp3TsRV8evkNk-99" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Lo único que hay que hacer, es inicializar en cero a *cola, para que apunten tanto primero como ultimo a NULL." vertex="1">
          <mxGeometry height="60" width="340" y="30" as="geometry" />
        </mxCell>
        <mxCell id="sU-Si7dAp3TsRV8evkNk-101" parent="sU-Si7dAp3TsRV8evkNk-99" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;void crearCola(t_cola *cola){&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; cola-&amp;gt;primero = cola-&amp;gt;ultimo = NULL;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;}&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="340" y="90" as="geometry" />
        </mxCell>
        <mxCell id="sU-Si7dAp3TsRV8evkNk-102" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-weight: 400;&quot;&gt;void eliminarCola(t_cola *cola)&lt;/span&gt;" vertex="1">
          <mxGeometry height="310" width="340" x="1880" y="1580" as="geometry">
            <mxRectangle height="30" width="190" x="850" y="600" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sU-Si7dAp3TsRV8evkNk-103" parent="sU-Si7dAp3TsRV8evkNk-102" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Basicamente, lo que hacemos es que mientras siga habiendo un primer elemento, vamos a guardar la direccion del primero en un nodo &quot;eliminar&quot;, cambiamos a t_cola -&amp;gt; al siguiente elemento, y recien ahi liberamos ese nodo auxiliar (y la informacion que lleva dentro)" vertex="1">
          <mxGeometry height="120" width="290" x="30" y="30" as="geometry" />
        </mxCell>
        <mxCell id="sU-Si7dAp3TsRV8evkNk-104" parent="sU-Si7dAp3TsRV8evkNk-102" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;void eliminarCola(t_cola *cola){&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; while(cola-&amp;gt;primero){&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; t_nodo *eliminar = cola-&amp;gt;primero;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; cola-&amp;gt;primero = eliminar-&amp;gt;sig;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; free(eliminar-&amp;gt;info);&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; free(eliminar);&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; cola-&amp;gt;ultimo = NULL;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;}&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="245" x="47.5" y="160" as="geometry" />
        </mxCell>
        <mxCell id="sU-Si7dAp3TsRV8evkNk-105" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="int ponerEnCola (t_cola *cola, void *dato, size_t tamDato )" vertex="1">
          <mxGeometry height="710" width="435" x="1880" y="1960" as="geometry">
            <mxRectangle height="30" width="340" x="1210" y="600" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sU-Si7dAp3TsRV8evkNk-106" parent="sU-Si7dAp3TsRV8evkNk-105" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;int ponerEnCola(t_cola *cola, const void *dato, size_t tamDato){&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; t_nodo *nuevo = (t_nodo*) malloc(sizeof(t_nodo));&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; if(!nuevo)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return SIN_MEMORIA;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; nuevo-&amp;gt;info = malloc(tamDato);&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; if(!nuevo-&amp;gt;info){&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; free(nuevo);&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return SIN_MEMORIA;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; nuevo-&amp;gt;tamInfo = tamDato;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; memcpy(nuevo-&amp;gt;info,dato,tamDato);&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; nuevo-&amp;gt;sig=NULL;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; if(!cola-&amp;gt;ultimo){&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; cola-&amp;gt;primero = nuevo;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; }else{&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; cola-&amp;gt;ultimo-&amp;gt;sig = nuevo;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; cola-&amp;gt;ultimo = nuevo;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; return TODO_BIEN;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;}&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="380" width="405" x="12.5" y="320" as="geometry" />
        </mxCell>
        <mxCell id="sU-Si7dAp3TsRV8evkNk-107" parent="sU-Si7dAp3TsRV8evkNk-105" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Poner un dato es agregar un nodo al final de la cola. Por esta razon se crea un t_nodo *nuevo. O sea, un puntero a la estructura t_nodo. Y como no se puede usar una primitiva dentro de otra, tenemos que asegurarnos de que haya suficiente memoria para crearlo. Una vez que nos aseguramos de esto, simplemente copiamos el dato que queramos en la informacion del nuevo nodo. Lo que viene despues es lo mas importante.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Hay dos posibles casos al agregar un elemento: Que sea el primero, o simplemente uno mas.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Si es el primero, decimos que cola-&amp;gt;primero debe apuntar al nuevo nodo.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Si no lo es, entonces antes de que cola-&amp;gt;ultimo apunte al nuevo elemento, tenemos que hacer que el actual ultimo, tambien apunte al nuevo. Porque sino despues perdemos la referencia.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Una vez que cola-&amp;gt;ultimo-&amp;gt;siguiente apunta al nuevo nodo, ahi si seguir.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Finalizando cualquiera de los dos casos, decimos que cola-&amp;gt;ultimo ahora apuntara al nodo recien creado.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="310" width="410" x="10" y="30" as="geometry" />
        </mxCell>
        <mxCell id="sU-Si7dAp3TsRV8evkNk-108" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="int sacarDeCola (t_cola *cola, void *dato, size_t tamDato)" vertex="1">
          <mxGeometry height="520" width="435" x="2340" y="1960" as="geometry">
            <mxRectangle height="30" width="340" x="1210" y="600" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sU-Si7dAp3TsRV8evkNk-109" parent="sU-Si7dAp3TsRV8evkNk-108" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;int sacarDeCola(t_cola *cola, void *dato, size_t tamDato){&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; t_nodo *eliminar = cola-&amp;gt;primero;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; if(!eliminar) // ! cola-&amp;gt;primero&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return COLA_VACIA;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; memcpy( dato, eliminar-&amp;gt;info, MIN(eliminar-&amp;gt;tamInfo, tamDato));&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; cola-&amp;gt;primero = eliminar-&amp;gt;sig;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; if(!cola-&amp;gt;primero)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; cola-&amp;gt;ultimo = NULL;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; free(eliminar-&amp;gt;info);&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; free(eliminar);&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; return TODO_BIEN;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;}&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="430" x="2.5" y="260" as="geometry" />
        </mxCell>
        <mxCell id="sU-Si7dAp3TsRV8evkNk-110" parent="sU-Si7dAp3TsRV8evkNk-108" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;sacarDePila extrae el primer elemento de la cola.&lt;/div&gt;&lt;div&gt;El t_nodo eliminar se crea para no eliminar a cola-&amp;gt;siguiente, ya que este debe seguir trabajando, una vez que saquemos este nodo.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Bueno, creamos este puntero auxiliar, que apunta al primer elemento de la cola. Nos aseguramos de que no sea nulo, y extraemos la informacion que tenia el nodo.&amp;nbsp;&lt;/div&gt;&lt;div&gt;Una vez hecho esto, ahora tenemos que actualizar a donde apunta&amp;nbsp;&lt;/div&gt;&lt;div&gt;t_cola-&amp;gt;primero. Y eso se busca en eliminar-&amp;gt;siguiente.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Si cuando hacemos esto, t_cola-&amp;gt;primero es igual a NULL, quiere decir que este era el ultimo elemento. SI ESO PASA, actualizamos a cola-&amp;gt;ultimo a NULL.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Y despues si ya podemos eliminar tanto a la informacion que tenia el nodo eliminar, y despues su direccion.&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="412.5" x="7.5" y="30" as="geometry" />
        </mxCell>
        <mxCell id="sU-Si7dAp3TsRV8evkNk-111" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="int verTopeDePila (t_pila *pila, void *dato, size_t tamDato)" vertex="1">
          <mxGeometry height="320" width="440" x="2800" y="1960" as="geometry" />
        </mxCell>
        <mxCell id="sU-Si7dAp3TsRV8evkNk-112" parent="sU-Si7dAp3TsRV8evkNk-111" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;int verPrimeroCola(const t_cola *cola, void *dato, size_t tamDato){&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; if(!cola-&amp;gt;primero)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; return COLA_VACIA;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; memcpy(dato, cola-&amp;gt;primero-&amp;gt;info, MIN(cola-&amp;gt;primero-&amp;gt;tamInfo, tamDato));&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; return TODO_BIEN;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;}&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="420" x="10" y="180" as="geometry" />
        </mxCell>
        <mxCell id="sU-Si7dAp3TsRV8evkNk-113" parent="sU-Si7dAp3TsRV8evkNk-111" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;En este caso buscamos ver el dato que hay en el primer elemento de la cola. No sacarlo. Asi que solamente hay que verificar que el primer elemento no sea nulo, y despues solo copiar el dato al que apunte t_cola-&amp;gt;primero-&amp;gt;info&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="410" x="15" y="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
