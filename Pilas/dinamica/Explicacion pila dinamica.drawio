          <mxGeometry height="50" width="150" x="25" y="40" as="geometry" />
        </mxCell>
        <mxCell id="AbAJmDd59ydRJxzXMzCG-91" parent="AbAJmDd59ydRJxzXMzCG-89" style="rounded=0;whiteSpace=wrap;html=1;" value="siguiente = *pila" vertex="1">
          <mxGeometry height="50" width="150" x="25" y="140" as="geometry" />
        </mxCell>
        <mxCell id="AbAJmDd59ydRJxzXMzCG-92" parent="AbAJmDd59ydRJxzXMzCG-89" style="rounded=0;whiteSpace=wrap;html=1;" value="size_t tamInfo" vertex="1">
          <mxGeometry height="50" width="150" x="25" y="90" as="geometry" />
        </mxCell>
