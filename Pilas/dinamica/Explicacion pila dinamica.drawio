        </mxCell>
        <mxCell id="AbAJmDd59ydRJxzXMzCG-122" parent="AbAJmDd59ydRJxzXMzCG-120" style="rounded=0;whiteSpace=wrap;html=1;" value="siguiente = *pila" vertex="1">
