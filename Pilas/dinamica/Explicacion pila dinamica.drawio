        <mxCell id="AbAJmDd59ydRJxzXMzCG-93" parent="AbAJmDd59ydRJxzXMzCG-87" style="rounded=0;whiteSpace=wrap;html=1;" value="*pila" vertex="1">
          <mxGeometry height="60" width="120" x="310" y="100" as="geometry" />
        </mxCell>
        <mxCell id="AbAJmDd59ydRJxzXMzCG-96" parent="AbAJmDd59ydRJxzXMzCG-80" style="swimlane;whiteSpace=wrap;html=1;" value="Tercer paso" vertex="1">
          <mxGeometry height="300" width="700" x="30" y="570" as="geometry" />
        </mxCell>
        <mxCell id="AbAJmDd59ydRJxzXMzCG-97" parent="AbAJmDd59ydRJxzXMzCG-96" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Apilamos OTRO nodo&lt;/h1&gt;&lt;p&gt;Mismo modo, pero lo hago para mostrar los cambios que hay. Pero tener en cuenta que aca *pila deberia tener la direccion del Nodo 1&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="170" x="260" y="40" as="geometry" />
