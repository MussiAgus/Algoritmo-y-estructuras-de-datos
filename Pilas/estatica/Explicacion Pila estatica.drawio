        <mxCell id="xv-Wq7fzhFBMuE0bBwwN-67" parent="xv-Wq7fzhFBMuE0bBwwN-66" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Basicamente, lo unico que tiene que hacer, es setear el tope de la pila, ya que el usuario le pasa la direccion de la pila ya creada." vertex="1">
          <mxGeometry height="60" width="340" y="30" as="geometry" />
        </mxCell>
        <mxCell id="xv-Wq7fzhFBMuE0bBwwN-68" parent="xv-Wq7fzhFBMuE0bBwwN-66" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;void crearPila(t_pila* pila)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; pila-&amp;gt;tope=TAM_MAX;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;}&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="340" y="90" as="geometry" />
        </mxCell>
        <mxCell id="xv-Wq7fzhFBMuE0bBwwN-69" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-weight: 400;&quot;&gt;void eliminarPila(t_pila* pila)&lt;/span&gt;" vertex="1">
          <mxGeometry height="200" width="220" x="480" y="780" as="geometry">
            <mxRectangle height="30" width="190" x="850" y="600" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="xv-Wq7fzhFBMuE0bBwwN-70" parent="xv-Wq7fzhFBMuE0bBwwN-69" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Es exactamente igual a crear la pila. Lo unico que hay que hacer, es setear el tope otra vez en el maximo, arriba de todo. Y despues los nuevos datos iran pisando los viejos." vertex="1">
