          <mxGeometry height="60" width="340" y="30" as="geometry" />
        </mxCell>
        <mxCell id="xv-Wq7fzhFBMuE0bBwwN-68" parent="xv-Wq7fzhFBMuE0bBwwN-66" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;void crearPila(t_pila* pila)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;{&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;&amp;nbsp; &amp;nbsp; pila-&amp;gt;tope=TAM_MAX;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 217, 102));&quot;&gt;}&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
