          <mxGeometry height="120" width="180" x="1280" y="180" as="geometry" />
        </mxCell>
        <mxCell id="xv-Wq7fzhFBMuE0bBwwN-66" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="&lt;b&gt;void crearPila (t_pila *pila)&lt;/b&gt;" vertex="1">
