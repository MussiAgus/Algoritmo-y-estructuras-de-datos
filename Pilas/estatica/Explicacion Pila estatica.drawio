        <mxCell id="xv-Wq7fzhFBMuE0bBwwN-60" parent="xv-Wq7fzhFBMuE0bBwwN-64" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="tope = 0" vertex="1">
