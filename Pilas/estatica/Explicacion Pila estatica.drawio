        <mxCell id="xv-Wq7fzhFBMuE0bBwwN-61" parent="xv-Wq7fzhFBMuE0bBwwN-64" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Tercer paso&lt;/h1&gt;&lt;p&gt;Bueno, entonces hay que guardar, en el espacio siguiente en memoria, un espacio para la variable size_t, la cual contendra el tamanio del dato que pusimos antes.&lt;/p&gt;" vertex="1">
