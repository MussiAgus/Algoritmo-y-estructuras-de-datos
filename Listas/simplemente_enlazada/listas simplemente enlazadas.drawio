        <mxCell id="Vh8Of3S5zd6qpqoBYnjE-28" parent="Vh8Of3S5zd6qpqoBYnjE-26" style="rounded=0;whiteSpace=wrap;html=1;" value="tamDato" vertex="1">
          <mxGeometry height="50" width="100" x="210" y="38" as="geometry" />
        </mxCell>
        <mxCell id="Vh8Of3S5zd6qpqoBYnjE-29" parent="Vh8Of3S5zd6qpqoBYnjE-26" style="rounded=0;whiteSpace=wrap;html=1;" value="nodo Siguiente" vertex="1">
          <mxGeometry height="52" width="100" x="210" y="88" as="geometry" />
        </mxCell>
        <mxCell id="Vh8Of3S5zd6qpqoBYnjE-37" parent="Vh8Of3S5zd6qpqoBYnjE-43" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Cuando hay mas de un nodo...&lt;/h1&gt;&lt;div&gt;t_lista siempre apunta al primer elemento de la lista. Es una referencia; un ancla. Los nodos estan conectados entre ellos mismos, desde su variable &quot;siguiente&quot;&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="187.64" x="550" y="140" as="geometry" />
        </mxCell>
        <mxCell id="Vh8Of3S5zd6qpqoBYnjE-31" parent="Vh8Of3S5zd6qpqoBYnjE-43" style="swimlane;whiteSpace=wrap;html=1;" value="Nodo 2" vertex="1">
