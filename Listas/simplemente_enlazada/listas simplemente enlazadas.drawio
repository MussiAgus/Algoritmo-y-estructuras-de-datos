        <mxCell id="_LPDqxuz1HFvSdkyO1Iw-12" parent="nHizgKOTyAuirEjp7zug-85" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Y queres recorrerla!&lt;/h1&gt;&lt;div&gt;Entonces usas alguna funcion, del estilo recorrerLista(t_lista*).&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Entonces mandarias esto:&lt;/div&gt;&lt;div&gt;recorrerLista(&amp;amp;lista);&lt;/div&gt;" vertex="1">
