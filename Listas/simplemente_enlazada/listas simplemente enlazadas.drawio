        <mxCell id="Vh8Of3S5zd6qpqoBYnjE-46" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="Pros y contras" vertex="1">
          <mxGeometry height="190" width="500" x="4160" y="1890" as="geometry" />
        </mxCell>
        <mxCell id="Vh8Of3S5zd6qpqoBYnjE-47" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;color: light-dark(rgb(255, 217, 102), rgb(255, 217, 102));&quot;&gt;Pros&lt;/font&gt;:&lt;div&gt;&amp;nbsp;Se pueden agregar y sacar elementos muy rapido.&lt;div&gt;Los nodos no se guardan todos juntos. Se guardan donde haya espacio.&lt;/div&gt;&lt;div&gt;Pueden tener longitud variable.&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(255, 217, 102), rgb(255, 217, 102));&quot;&gt;Contras&lt;/font&gt;:&lt;/div&gt;&lt;div&gt;No tienen nocion de indice. Si quiero buscar algo, tengo que iterar hasta la, por ejemplo, quinta posicion.&lt;/div&gt;&lt;div&gt;Necesitan almacenar punteros, por lo que ocupan mas espacio en memoria.&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="460" x="4180" y="1920" as="geometry" />
        </mxCell>
