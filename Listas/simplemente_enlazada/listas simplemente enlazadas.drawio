        <mxCell id="Vh8Of3S5zd6qpqoBYnjE-22" parent="Vh8Of3S5zd6qpqoBYnjE-19" style="rounded=0;whiteSpace=wrap;html=1;" value="nodo Siguiente" vertex="1">
