        <mxCell id="Vh8Of3S5zd6qpqoBYnjE-24" parent="Vh8Of3S5zd6qpqoBYnjE-41" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;t_lista&lt;/h1&gt;&lt;div&gt;Una variable del tipo t_lista, simplemente es una variable creada para apuntar a un t_nodo&lt;/div&gt;" vertex="1">
