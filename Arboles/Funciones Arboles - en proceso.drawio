        <mxCell id="Ps6-geXKNtSoJx2oELTp-115" parent="Ps6-geXKNtSoJx2oELTp-94" style="rounded=0;whiteSpace=wrap;html=1;" value="con p2 --&amp;gt; Tercer movimiento : 27 &amp;lt; 30 entonces p = &amp;amp;(*p)-&amp;gt;izq&amp;nbsp;" vertex="1">
