        <mxCell id="KyCDOiZGBgvcGg3TBiEc-1" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="Buscar un nodo." vertex="1">
          <mxGeometry height="1560" width="900" x="1480" y="480" as="geometry" />
        </mxCell>
        <mxCell id="KyCDOiZGBgvcGg3TBiEc-55" parent="KyCDOiZGBgvcGg3TBiEc-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Aca hay dos opciones&lt;/h1&gt;&lt;div&gt;Cuando buscas un nodo, podes querer una de dos opciones:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- Buscar para devolver la direccion del nodo.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- Buscar para devolver el contenido del nodo.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Hay solo unas pocas diferencias entre ambos. Vamos a ver los dos.&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="380" x="20" y="50" as="geometry" />
        </mxCell>
        <mxCell id="KyCDOiZGBgvcGg3TBiEc-56" parent="KyCDOiZGBgvcGg3TBiEc-1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" value="25" vertex="1">
